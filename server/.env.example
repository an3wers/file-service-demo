# Шаблон конфигурации сервера. Скопируйте в .env и заполните значения:
#   cp .env.example .env
# Полное описание каждого ключа — в server/README.md.
# Что именно меняется при деплое на сервер — в docs/deploy.md.

# --- S3 (Cloud.ru Object Storage) ---
S3_DOMAIN=replace-me
S3_ENDPOINT=https://s3.cloud.ru
S3_REGION=ru-central-1
S3_BUCKET_NAME=replace-me
S3_TENANT_ID=replace-me
S3_SERVICE_NAME=s3
KEY_ID=replace-me
KEY_SECRET=replace-me

# --- PostgreSQL ---
# Для локального запуска — Postgres из docker compose, значения совпадают с
# корневым .env. В контейнере сервера compose перекрывает эти ключи сам.
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=file_service_db
DATABASE_USER=file_service
DATABASE_PASSWORD=replace-me
DATABASE_POOL_SIZE=10
DATABASE_SSL=false

# --- HTTP ---
NODE_ENV=production
PORT=3000
LOG_LEVEL=info
# Origin, с которого открывается клиент. Список через запятую.
# Он же уходит в CORS бакета скриптом s3:cors — после правки перезапустить.
CORS_ORIGIN=http://localhost:5173
# Swagger UI на /api/docs и спецификация на /api/openapi.json, без токена.
# Не задано — включено везде, кроме NODE_ENV=production.
# API_DOCS_ENABLED=true

# --- Загрузки ---
MAX_UPLOAD_SIZE_MB=50
PRESIGN_UPLOAD_TTL_SECONDS=900
PRESIGN_DOWNLOAD_TTL_SECONDS=300
PENDING_TTL_HOURS=24

# --- Multipart (значения ниже — умолчания, можно не задавать) ---
# MULTIPART_THRESHOLD_MB=100
# MULTIPART_PART_SIZE_MB=16
# MULTIPART_MAX_CONCURRENCY=4
# MAX_OBJECT_SIZE_GB=200

# --- Вход ---
# Единственный пользователь. Сервер заводит его при старте; смена пароля здесь
# и рестарт завершают все его сессии. Пароль — минимум 8 символов.
LOGIN_USER_APP=replace-me
PASSWORD_USER_APP=replace-me
# Минимум 32 символа каждый, разные. Сгенерировать: openssl rand -base64 48
JWT_ACCESS_SECRET=replace-me-at-least-32-characters-long
JWT_REFRESH_SECRET=replace-me-at-least-32-characters-long
JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_DAYS=7
# Флаг Secure у cookie токена обновления. true только за HTTPS: по HTTP браузер
# молча выбросит такую cookie, и продление перестанет работать.
COOKIE_SECURE=false

NOTIFICATION_ENABLED=false
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_TLS_MODE=implicit
# SMTP_USER=sender@gmail.com
# SMTP_PASSWORD=google-app-password
# SMTP_FROM=sender@gmail.com
SMTP_CONNECTION_TIMEOUT_MS=10000
SMTP_GREETING_TIMEOUT_MS=10000
SMTP_SOCKET_TIMEOUT_MS=30000

AUTH_PUBLIC_URL=https://files.example.com
AUTH_ALLOWED_ORIGINS=http://localhost:5173
AUTH_RESPONSE_DEADLINE_MS=15000
TRUSTED_PROXIES=
