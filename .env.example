# Шаблон конфигурации docker compose. Скопируйте в .env и заполните значения:
#   cp .env.example .env
# Compose читает этот файл сам; настройки сервера живут в server/.env.

# --- PostgreSQL ---
# При запуске сервера через `npm run dev` укажите те же значения в server/.env:
# DATABASE_HOST=localhost, DATABASE_PORT=POSTGRES_PORT, DATABASE_NAME=POSTGRES_DB,
# DATABASE_USER=POSTGRES_USER, DATABASE_PASSWORD=POSTGRES_PASSWORD.
# В контейнере сервера compose подставляет их сам.
POSTGRES_DB=file_service_db
POSTGRES_USER=file_service
# Сгенерировать: openssl rand -base64 32
POSTGRES_PASSWORD=replace-me
# Порт на хосте; БД слушает только 127.0.0.1.
POSTGRES_PORT=5432
